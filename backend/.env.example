APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=1
JWT_REFRESH_EXPIRE_DAYS=7

DB_PATH=./data/psp.db
VEC_DB_PATH=./data/psp_vec.db
ONTOLOGY_DB_PATH=./data/psp_ontology.db

# Neo4j（图存储唯一主存；启动期 fail-fast）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT=5.0
NEO4J_MAX_POOL_SIZE=100
NEO4J_ACQUIRE_TIMEOUT=60.0

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLE_THINKING=
LLM_REASONING_BUDGET=
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_MAX_TOKENS=
LLM_TOOL_CALL_MODE=auto

# Phase B Harness
AI_DEFAULT_MAX_ROUNDS=3
AI_COMPLEX_MAX_ROUNDS=5
AI_WORKFLOW_MAX_ROUNDS=8
AI_DEFAULT_MAX_LATENCY_MS=90000
AI_COMPLEX_MAX_LATENCY_MS=120000
AI_ENABLE_ACTION_GATEWAY=true
AI_ENABLE_RUN_CHECKPOINT=true
AI_ENABLE_OTEL_SPANS=true

# 嵌入配置：当前 qwen3（Qwen3-Embedding-0.6B，modelscope 仓库 id）
# EMBEDDING_MODEL 是 modelscope 仓库 id，SDK 会从 MODELSCOPE_CACHE 找，找不到则下载
# 兜底：hash（sklearn HashingVectorizer，零下载）
# 后期：openai（text-embedding-3-small/large）
EMBEDDING_PROVIDER=qwen3
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_LENGTH=8192
# MODELSCOPE_CACHE=  # 留空走 SDK 默认（~/.cache/modelscope/hub），或显式指定


LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
